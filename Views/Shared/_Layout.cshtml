<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Controle Financeiro MEI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primario">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">💜 Controle Financeiro MEI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Painel</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Transacoes" asp-action="Index">Lançamentos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Metas" asp-action="Index">Metas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Captacoes" asp-action="Index">Captação de Recursos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center me-3 text-white-50 small">
                                Olá, @User.Identity!.Name
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Conta" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Conta" asp-action="Login">Entrar</a></li>
                            <li class="nav-item"><a class="btn btn-light btn-sm ms-2" asp-controller="Conta" asp-action="Registro">Criar conta</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5">
        @if (TempData["Erro"] is string mensagemErro)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @mensagemErro
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Sucesso"] is string mensagemSucesso)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensagemSucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container">
            Controle Financeiro MEI &copy; @DateTime.Now.Year — Trabalho de Conclusão de Curso (protótipo acadêmico)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
