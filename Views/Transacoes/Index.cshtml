@model List<Transacao>
@{
    ViewData["Title"] = "Fluxo de Caixa";
    var mes = (int)ViewData["Mes"]!;
    var ano = (int)ViewData["Ano"]!;
    var totalReceitas = (decimal)ViewData["TotalReceitas"]!;
    var totalDespesas = (decimal)ViewData["TotalDespesas"]!;
    var saldo = totalReceitas - totalDespesas;
    var nomeMes = new DateTime(ano, mes, 1).ToString("MMMM/yyyy", new System.Globalization.CultureInfo("pt-BR"));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fluxo de Caixa</h2>
    <a class="btn btn-primary" asp-action="Create">+ Novo lançamento</a>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Mês</label>
        <select name="mes" class="form-select">
            @for (int m = 1; m <= 12; m++)
            {
                var nome = new DateTime(2024, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("pt-BR"));
                if (m == mes)
                {
                    <option value="@m" selected>@nome</option>
                }
                else
                {
                    <option value="@m">@nome</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Ano</label>
        <input type="number" name="ano" value="@ano" class="form-control" style="width: 8rem" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-resumo p-3">
            <span class="text-muted small">Receitas em @nomeMes</span>
            <span class="valor valor-receita">R$ @totalReceitas.ToString("N2")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-resumo p-3">
            <span class="text-muted small">Despesas em @nomeMes</span>
            <span class="valor valor-despesa">R$ @totalDespesas.ToString("N2")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-resumo p-3">
            <span class="text-muted small">Saldo do mês</span>
            <span class="valor @(saldo >= 0 ? "valor-receita" : "valor-despesa")">R$ @saldo.ToString("N2")</span>
        </div>
    </div>
</div>

<div class="card card-resumo p-3">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Categoria</th>
                <th>Tipo</th>
                <th class="text-end">Valor</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transacao in Model)
            {
                <tr>
                    <td>@transacao.Data.ToString("dd/MM/yyyy")</td>
                    <td>@transacao.Descricao</td>
                    <td>@transacao.Categoria?.Nome</td>
                    <td>
                        @if (transacao.Tipo == TipoTransacao.Receita)
                        {
                            <span class="badge badge-receita">Receita</span>
                        }
                        else
                        {
                            <span class="badge badge-despesa">Despesa</span>
                        }
                    </td>
                    <td class="text-end">R$ @transacao.Valor.ToString("N2")</td>
                    <td class="text-end tabela-acoes">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@transacao.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@transacao.Id">Excluir</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Nenhum lançamento neste período.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
