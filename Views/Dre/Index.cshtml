@model DreMensal
@{
    ViewData["Title"] = "DRE";
    var nomeMes = new DateTime(Model.Ano, Model.Mes, 1).ToString("MMMM/yyyy", new System.Globalization.CultureInfo("pt-BR"));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>DRE — Demonstrativo de Resultado do Exercício</h2>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Mês</label>
        <select name="mes" class="form-select">
            @for (int m = 1; m <= 12; m++)
            {
                var nome = new DateTime(2024, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("pt-BR"));
                if (m == Model.Mes)
                {
                    <option value="@m" selected>@nome</option>
                }
                else
                {
                    <option value="@m">@nome</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Ano</label>
        <input type="number" name="ano" value="@Model.Ano" class="form-control" style="width: 8rem" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

@if (!Model.HouveMovimentacao)
{
    <div class="alert alert-secondary">Nenhum lançamento em @nomeMes ainda. Cadastre receitas e despesas em "Lançamentos" para ver o DRE deste mês.</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card card-resumo p-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Estrutura da DRE</th>
                        <th class="text-end">Valor (R$)</th>
                        <th>O que significa na prática?</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>(+) RECEITA BRUTA TOTAL</td>
                        <td class="text-end valor-receita fw-bold">R$ @Model.ReceitaBrutaTotal.ToString("N2")</td>
                        <td class="text-muted small">Tudo o que a empreendedora vendeu no mês.</td>
                    </tr>
                    <tr>
                        <td>(–) Deduções e Impostos</td>
                        <td class="text-end valor-despesa">R$ @Model.DeducoesEImpostos.ToString("N2")</td>
                        <td class="text-muted small">Impostos (ex.: DAS) e deduções sobre as vendas.</td>
                    </tr>
                    <tr class="table-light">
                        <td>(=) RECEITA LÍQUIDA</td>
                        <td class="text-end fw-bold">R$ @Model.ReceitaLiquida.ToString("N2")</td>
                        <td class="text-muted small">O dinheiro que sobra "limpo" das vendas.</td>
                    </tr>
                    <tr>
                        <td>(–) Custo da Mercadoria Vendida (CMV)</td>
                        <td class="text-end valor-despesa">R$ @Model.CustoMercadoriaVendida.ToString("N2")</td>
                        <td class="text-muted small">Valor pago aos fornecedores pelos produtos vendidos.</td>
                    </tr>
                    <tr class="table-light">
                        <td>(=) LUCRO BRUTO</td>
                        <td class="text-end fw-bold">R$ @Model.LucroBruto.ToString("N2")</td>
                        <td class="text-muted small">Ganho bruto antes de pagar a estrutura de custos.</td>
                    </tr>
                    <tr>
                        <td>(–) Despesas Variáveis</td>
                        <td class="text-end valor-despesa">R$ @Model.DespesasVariaveis.ToString("N2")</td>
                        <td class="text-muted small">Taxas de cartão, embalagens, anúncios, etc.</td>
                    </tr>
                    <tr>
                        <td>(–) Despesas Fixas</td>
                        <td class="text-end valor-despesa">R$ @Model.DespesasFixas.ToString("N2")</td>
                        <td class="text-muted small">Aluguel, internet, sistema de gestão, etc.</td>
                    </tr>
                    <tr class="@(Model.LucroLiquido >= 0 ? "table-success" : "table-danger")">
                        <td class="fw-bold">(=) LUCRO LÍQUIDO DO MÊS</td>
                        <td class="text-end fw-bold">R$ @Model.LucroLiquido.ToString("N2")</td>
                        <td class="small">@(Model.LucroLiquido >= 0 ? "Lucro real do mês." : "Prejuízo no mês: as despesas superaram a receita.")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card card-resumo p-3 card-dre-grafico">
            <h5 class="mb-3">Composição do resultado — @nomeMes</h5>
            @if (Model.PodeExibirGraficoPizza)
            {
                <canvas id="graficoDre"></canvas>
            }
            else if (Model.HouveMovimentacao)
            {
                <div class="alert alert-warning mb-0">
                    Houve prejuízo em @nomeMes, então esse mês não é representado em gráfico de pizza
                    (as despesas totais superaram a receita bruta). Veja os valores na tabela ao lado.
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Sem lançamentos neste mês para montar o gráfico.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
@if (Model.PodeExibirGraficoPizza)
{
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            const dadosDre = [
                { label: 'Lucro Líquido', valor: @Model.LucroLiquido.ToString(System.Globalization.CultureInfo.InvariantCulture), cor: '#3f6fea' },
                { label: 'Custo da Mercadoria (CMV)', valor: @Model.CustoMercadoriaVendida.ToString(System.Globalization.CultureInfo.InvariantCulture), cor: '#d2790a' },
                { label: 'Despesas Fixas', valor: @Model.DespesasFixas.ToString(System.Globalization.CultureInfo.InvariantCulture), cor: '#8e24aa' },
                { label: 'Despesas Variáveis', valor: @Model.DespesasVariaveis.ToString(System.Globalization.CultureInfo.InvariantCulture), cor: '#e91e8c' },
                { label: 'Deduções/Impostos', valor: @Model.DeducoesEImpostos.ToString(System.Globalization.CultureInfo.InvariantCulture), cor: '#123a68' }
            ].filter(d => d.valor > 0);

            const receitaBruta = @Model.ReceitaBrutaTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);

            const ctx = document.getElementById('graficoDre');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: dadosDre.map(d => d.label),
                    datasets: [{
                        data: dadosDre.map(d => d.valor),
                        backgroundColor: dadosDre.map(d => d.cor),
                        borderColor: '#16181d',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                color: '#f1f1f1',
                                generateLabels: (chart) => chart.data.labels.map((label, i) => {
                                    const valor = chart.data.datasets[0].data[i];
                                    const pct = receitaBruta ? (valor / receitaBruta * 100).toFixed(1) : '0.0';
                                    return {
                                        text: `${label}: ${pct}%`,
                                        fillStyle: chart.data.datasets[0].backgroundColor[i],
                                        index: i
                                    };
                                })
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: (item) => {
                                    const valor = item.parsed;
                                    const pct = receitaBruta ? (valor / receitaBruta * 100).toFixed(1) : '0.0';
                                    return `${item.label}: R$ ${valor.toLocaleString('pt-BR', {minimumFractionDigits:2})} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        </script>
}
}
