@model CalculadoraPrecoViewModel
@{
    ViewData["Title"] = "Calculadora de preço";
    var e = Model.Entrada;
    var r = Model.Resultado;
    var pt = new System.Globalization.CultureInfo("pt-BR");
    var nomeMesSugestao = new DateTime(Model.Sugestao.Ano, Model.Sugestao.Mes, 1).ToString("MMMM/yyyy", pt);
    string V(decimal? valor) => valor.HasValue ? valor.Value.ToString("0.##", pt) : string.Empty;
}

<h2 class="mb-1">Calculadora de preço</h2>
<p class="text-muted mb-4">
    Descubra por quanto vender cada produto ou serviço para pagar os custos e ainda ter lucro.
    Nada aqui é gravado: é só uma conta para ajudar você a decidir.
</p>

<div class="row g-4">
    <div class="col-lg-6">
        <form method="get" class="card card-resumo p-3">
            <div class="mb-3">
                <label class="form-label fw-semibold" for="CustoUnitario">Quanto custa fazer (ou comprar) uma unidade? (R$)</label>
                <input class="form-control form-control-lg" id="CustoUnitario" name="CustoUnitario" inputmode="decimal" value="@V(e.CustoUnitario)" placeholder="Ex.: 25,00" />
                <div class="form-text">Material, mercadoria e embalagem de <strong>uma</strong> peça ou serviço.</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="CustosFixosMes">Custos fixos do mês (R$)</label>
                <input class="form-control form-control-lg" id="CustosFixosMes" name="CustosFixosMes" inputmode="decimal" value="@V(e.CustosFixosMes)" />
                <div class="form-text" id="sugestaoCustosFixos">
                    Contas que vêm todo mês, vendendo ou não (aluguel, internet, DAS...).
                    @if (Model.Sugestao.Valor > 0)
                    {
                        <span>Em @nomeMesSugestao você lançou <strong>R$ @Model.Sugestao.Valor.ToString("N2", pt)</strong> de despesas fixas.</span>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="QuantidadeMes">Quantas unidades você vende por mês?</label>
                <input class="form-control form-control-lg" id="QuantidadeMes" name="QuantidadeMes" inputmode="numeric" value="@e.QuantidadeMes" placeholder="Ex.: 40" />
                <div class="form-text">Os custos fixos são divididos por essa quantidade.</div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label fw-semibold" for="TaxasPercentual">Taxas sobre a venda (%)</label>
                    <input class="form-control form-control-lg" id="TaxasPercentual" name="TaxasPercentual" inputmode="decimal" value="@V(e.TaxasPercentual)" />
                    <div class="form-text">Ex.: maquininha de cartão, comissão.</div>
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold" for="LucroPercentual">Lucro que você quer ter (%)</label>
                    <input class="form-control form-control-lg" id="LucroPercentual" name="LucroPercentual" inputmode="decimal" value="@V(e.LucroPercentual)" />
                    <div class="form-text">Parte do preço que fica para você.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Calcular preço</button>
        </form>
    </div>

    <div class="col-lg-6">
        @if (r is null)
        {
            <div class="card card-resumo p-3 h-100">
                <h5>Como a conta é feita</h5>
                <p class="text-muted mb-2">
                    O preço precisa cobrir o custo da unidade, uma parte dos custos fixos e as taxas, e ainda
                    deixar o lucro que você escolheu:
                </p>
                <p class="mb-2"><strong>Preço</strong> = (custo da unidade + custos fixos ÷ unidades) ÷ (1 − (taxas + lucro) ÷ 100)</p>
                <p class="text-muted small mb-0">É o método do <em>mark-up</em>, muito usado por pequenos negócios.</p>
            </div>
        }
        else if (!r.Valido)
        {
            <div class="alert alert-warning" id="errosCalculadora">
                <strong>Confira os valores:</strong>
                <ul class="mb-0">
                    @foreach (var erro in r.Erros)
                    {
                        <li>@erro</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="card card-resumo p-3 text-center mb-3" id="precoSugerido">
                <span class="text-muted">Preço sugerido por unidade</span>
                <span class="display-5 fw-bold valor-receita">R$ @r.PrecoSugerido.ToString("N2", pt)</span>
            </div>
            <div class="card card-resumo p-3">
                <h5 class="mb-3">Para onde vai cada venda</h5>
                <table class="table mb-0">
                    <tbody>
                        <tr><td>Custo da unidade</td><td class="text-end">R$ @((e.CustoUnitario ?? 0).ToString("N2", pt))</td></tr>
                        <tr><td>Parte dos custos fixos</td><td class="text-end">R$ @r.CustoFixoPorUnidade.ToString("N2", pt)</td></tr>
                        <tr><td>Taxas</td><td class="text-end">R$ @r.TaxasPorUnidade.ToString("N2", pt)</td></tr>
                        <tr class="table-success fw-bold"><td>Seu lucro</td><td class="text-end">R$ @r.LucroPorUnidade.ToString("N2", pt)</td></tr>
                    </tbody>
                </table>
                <p class="mt-3 mb-0" id="resumoMes">
                    Vendendo <strong>@e.QuantidadeMes</strong> unidades por mês a esse preço, você fatura
                    <strong>R$ @r.FaturamentoNoMes.ToString("N2", pt)</strong> e tem
                    <strong>R$ @r.LucroNoMes.ToString("N2", pt)</strong> de lucro no mês.
                </p>
            </div>
        }
    </div>
</div>
