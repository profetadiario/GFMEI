classDiagram
    direction LR
    class ICalculadoraPrecoService {
        <<interface>>
        +Calcular(entrada) ResultadoCalculadoraPreco
        +ObterValoresSugeridosAsync(usuarioId, hoje)
    }
    class CalculadoraPrecoService {
        -AppDbContext _context
        +Calcular(entrada) ResultadoCalculadoraPreco
        +ObterValoresSugeridosAsync(usuarioId, hoje)
        +Truncar(valor)$ decimal
    }
    class EntradaCalculadoraPreco {
        +decimal DiasTrabalho
        +decimal HorasPorDia
        +decimal MinutosPorUnidade
        +decimal CustoVariavelUnidade
        +decimal LucroPercentual
        +ItemMensal[] CustosFixos
        +ItemMensal[] DespesasFixas
        +ItemMensal[] DespesasVariaveis
    }
    class ItemMensal {
        +string Nome
        +decimal Valor
    }
    class ResultadoCalculadoraPreco {
        +bool Valido
        +string[] Erros
        +decimal CustosFixosUnidade
        +decimal CustoVariavelUnidade
        +decimal Base
        +decimal DespesasFixasUnidade
        +decimal DespesasVariaveisUnidade
        +decimal TotalGeral
        +decimal DespesasFixasPercentual
        +decimal DespesasVariaveisPercentual
        +decimal Markup
        +decimal PrecoSugerido
    }
    class SugestaoValoresMensais {
        +int MesesConsiderados
        +ValorSugerido[] CustosFixos
        +ValorSugerido[] DespesasFixas
        +ValorSugerido[] DespesasVariaveis
    }
    class IRelatorioCreditoService {
        <<interface>>
        +ObterRelatorioAsync(usuarioId, hoje) RelatorioCredito
    }
    class RelatorioCreditoService {
        -AppDbContext _context
        +ObterRelatorioAsync(usuarioId, hoje) RelatorioCredito
    }
    class RelatorioCredito {
        +MesRelatorio[] Meses
        +int MesesConsiderados
        +decimal FaturamentoTotal
        +decimal FaturamentoMedio
        +decimal LucroLiquido
        +decimal SobraMedia
        +decimal ParcelaConfortavel
        +decimal TotalCaptado
        +PercentualDaSobra(parcela) decimal
        +AvaliarParcela(parcela) SituacaoParcela
    }
    class MesRelatorio {
        +int Mes
        +int Ano
        +decimal Receitas
        +decimal DespesasDoNegocio
        +decimal LucroLiquido
        +decimal Sobra
        +decimal SaldoFinal
    }
    class SituacaoParcela {
        <<enumeration>>
        SemDados
        Confortavel
        Atencao
        Arriscada
    }
    ICalculadoraPrecoService <|.. CalculadoraPrecoService : implementa
    CalculadoraPrecoService ..> EntradaCalculadoraPreco : recebe
    CalculadoraPrecoService ..> ResultadoCalculadoraPreco : produz
    EntradaCalculadoraPreco "1" *-- "*" ItemMensal
    CalculadoraPrecoService ..> SugestaoValoresMensais : sugere (pró-labore nos custos fixos)
    IRelatorioCreditoService <|.. RelatorioCreditoService : implementa
    RelatorioCreditoService ..> RelatorioCredito : produz
    RelatorioCredito "1" *-- "12" MesRelatorio
    RelatorioCredito ..> SituacaoParcela : avalia
