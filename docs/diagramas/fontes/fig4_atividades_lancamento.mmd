flowchart TB
    I((Início)) --> A{"Está autenticada?"}
    A -- Não --> L["Exibir tela de login"] --> A
    A -- Sim --> F["Abrir lançamento rápido<br/>(Novo lançamento)"]
    F --> T["Escolher tipo:<br/>entrada ou saída"]
    T --> V["Informar o valor"]
    V --> C["Escolher a categoria<br/>(descrição opcional)"]
    C --> P{"Categoria é o<br/>pró-labore?"}
    P -- Sim --> H["Mostrar a ajuda: lance o<br/>pró-labore uma vez,<br/>no fechamento do mês"]
    P -- Não --> D
    H --> D{"Dados válidos?<br/>categoria compatível<br/>com o tipo?"}
    D -- Não --> E["Exibir mensagens de erro"] --> T
    D -- Sim --> R{"Pró-labore já<br/>lançado no mês?"}
    R -- Sim --> W["Aviso (não bloqueia):<br/>salvar mesmo assim?"]
    W -- Não --> T
    W -- Sim --> S
    R -- Não --> S["Salvar lançamento<br/>(descrição vazia = nome da categoria)"]
    S --> X["DRE, fluxo de caixa e painel<br/>recalculados<br/>(pró-labore nas despesas fixas)"]
    X --> N{"Salvar e<br/>lançar outro?"}
    N -- Sim --> T
    N -- Não --> LI["Exibir a lista de lançamentos<br/>com o saldo do mês"] --> FIM((Fim))
    classDef inicio fill:#6f2c91,stroke:#6f2c91,color:#fff;
    classDef decisao fill:#fdf1dc,stroke:#d4a017;
    class I,FIM inicio;
    class A,P,D,R,W,N decisao;
